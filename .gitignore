# Data files
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/ocr/*
!data/ocr/.gitkeep
data/output/*
!data/output/.gitkeep
logs/*.log
!logs/.gitkeep

# Python virtual environments & environment variables
.venv/
.venv*/
venv/
venv*/
env/
ENV/
env.bak/
venv.bak/
.venv-win/
.env
.env.local
.env.*.local

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node & Next.js frontend builds
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo

# IDE, OS & System files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
