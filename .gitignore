# Data files & Storage
data/raw_pdfs/*
!data/raw_pdfs/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/ocr/*
!data/ocr/.gitkeep
data/output/*
!data/output/.gitkeep
logs/*.log
!logs/.gitkeep

# Python Virtual Environments & Environment Variables
.venv
.venv/
.venv*/
*.venv
*.venv/
venv
venv/
venv*/
env
env/
ENV/
env.bak/
venv.bak/
.venv-win
.venv-win/
.venv-win*/
.venv-linux/
.venv-mac/
.env
.env.local
.env.*.local

# Python Bytecode & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
pip-wheel-metadata/

# Node & Next.js Frontend Builds
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/*.tsbuildinfo

# IDE, OS & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
